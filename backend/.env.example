# Server Port configuration (starting port)
PORT=5000

# Server Port range configuration (automatically switches if port 5000 is blocked/in use)
PORT_RANGE=20
# MAX_PORT=5020

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ace_logistics?retryWrites=true&w=majority

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_here

# JSON Web Token Expiration Duration
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin URL
CLIENT_URL=http://localhost:5173
